&lt;td&gt;6&lt;/td&gt;
&lt;td&gt;마스트 / 앵커&lt;/td&gt;
&lt;td&gt;145&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;7&lt;/td&gt;
&lt;td&gt;리타&lt;/td&gt;
&lt;td&gt;140 미만&lt;/td&gt;
&lt;/tr&gt;
